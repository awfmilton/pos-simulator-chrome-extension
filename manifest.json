{
  "manifest_version": 3,
  "name": "tbay.tk Virtual Peripheral Simulator",
  "version": "2.1.2",
  "description": "Virtual peripheral simulator for testing the tbay.tk Point of Sale: card terminals, receipt printers, barcode scanners, scales, cash drawers and line displays.",
  "author": "Alexander Milton",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tbay.tk/*",
        "https://tbay.tk/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interceptor.js"
      ],
      "matches": [
        "https://*.tbay.tk/*",
        "https://tbay.tk/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open POS Peripheral Simulator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*.tbay.tk/*",
    "https://tbay.tk/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*"
  ]
}
